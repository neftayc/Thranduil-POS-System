# Copy to .env and inject the variables into your process, e.g. set -a; source .env; set +a
YACHAY_SYSTEMS=./systems.json
# generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
YACHAY_SIGNING_KEY=replace-with-random-long-secret
# Fixed inbound header for SINGLE USER / STAGING ONLY (not OAuth; replace for multiuser production)
YACHAY_MCP_KEY=replace-with-another-long-secret
# For local development: localhost-only. For production use a TLS reverse proxy.
YACHAY_HOST=127.0.0.1
YACHAY_PORT=8000
# Comma separated, include public hostname when deploying (e.g., mcp.example.com)
YACHAY_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Credential sent from connector to selected system. Never include in prompt/context.
POS_AGENT_TOKEN=replace-with-pos-service-token
# Optional when enabling hotel in systems.json
PMS_AGENT_TOKEN=
