# Server-only Supabase credentials (used by server/api/*).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Legacy (avoid): would be public in Nuxt if set.
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_APP_NAME=Papeleria

# WhatsApp Meta API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=papeleria_kuska_token_2026

# Yachay -> POS: independent secret, at least 32 characters. Server-only.
POS_AGENT_TOKEN=
# Encrypts the Supabase session each seller opens at /vincular (min. 32 chars).
# Sales are registered AS that seller; there is no shared seller token anymore.
POS_AGENT_SESSION_KEY=
# Optional: public origin for the /vincular link (remote phase). Defaults to request origin.
POS_AGENT_PUBLIC_URL=
# Hours a "venta por confirmar" keeps its stock reservation.
POS_AGENT_REVIEW_TTL_HOURS=48
POS_AGENT_MODEL=gpt-4o-mini
# Embeddings for the hybrid product search (vector(1536); text-embedding-3-* models).
POS_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# 1 = compute product vectors in the background while searching (WRITES to the database). Off by default.
POS_AGENT_SEARCH_AUTOINDEX=
# 1 = validation only: real reads, never registers a sale. Off by default.
POS_AGENT_DRY_RUN=
# Durable local directory; shared serverless deployments need a transactional store.
POS_AGENT_STORAGE_DIR=.data/agent
