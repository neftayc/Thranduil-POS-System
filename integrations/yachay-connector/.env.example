# Copy to .env and inject the variables into your process, e.g. set -a; source .env; set +a
YACHAY_SYSTEMS=./systems.json
# Required. Encrypts selection tokens (system + seller session reference).
# generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
YACHAY_SIGNING_KEY=replace-with-random-long-secret
# Only "local" exists in this phase: binds to loopback. Remote HTTPS is phase 2.
YACHAY_MODE=local
YACHAY_HOST=127.0.0.1
YACHAY_PORT=8000
# OPTIONAL development-only header (x-yachay-connector-key). Leave empty to disable.
# It is NOT seller identity and must never be the access control for remote use.
YACHAY_MCP_KEY=
# Comma separated hosts accepted by the MCP transport (DNS rebinding protection)
YACHAY_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Service credential sent from connector to the selected system. Never include in prompt/context.
POS_AGENT_TOKEN=replace-with-pos-service-token
# Optional when enabling hotel in systems.json
PMS_AGENT_TOKEN=
