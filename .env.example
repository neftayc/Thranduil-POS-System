# Server-only Supabase credentials (used by server/api/*).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Legacy (avoid): would be public in Nuxt if set.
# NUXT_PUBLIC_SUPABASE_URL=
# NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_APP_NAME=Papeleria

# WhatsApp Meta API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=papeleria_kuska_token_2026

# Yachay -> POS: independent secret, at least 32 characters. Server-only.
POS_AGENT_TOKEN=
# Optional temporary session of an existing authorized POS seller.
# Without it, the agent prepares drafts but cannot commit a sale.
# Conversation-based identification will replace this single-operator configuration.
POS_AGENT_SELLER_ACCESS_TOKEN=
POS_AGENT_MODEL=gpt-4o-mini
# Embeddings for the hybrid product search (vector(1536); text-embedding-3-* models).
POS_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# Durable local directory; shared serverless deployments need a transactional store.
POS_AGENT_STORAGE_DIR=.data/agent
